# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/beacon.db

# Authentication (Keycloak OIDC)
# Demo mode: set KEYCLOAK_URL to enable local Keycloak; leave empty for demo binder
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=beacon
KEYCLOAK_CLIENT_ID=beacon-pilot
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# OIDC settings (used by frontend for PKCE)
OIDC_ISSUER=http://127.0.0.1:8080/realms/beacon
OIDC_CLIENT_ID=beacon-pilot
OIDC_REDIRECT_URI=http://127.0.0.1:5173/callback
OIDC_SCOPES=openid profile email roles

# Session (backend-managed cookies)
SESSION_SECRET=dev-secret-change-in-production
SESSION_COOKIE_NAME=beacon_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# LLM (optional, server-side only)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=30

# Trusted base ref for repository memory freshness
TRUSTED_BASE_REF=origin/main